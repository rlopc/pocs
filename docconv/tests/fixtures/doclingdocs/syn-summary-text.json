            "start_col_offset_idx": 2,
            "end_col_offset_idx": 3,
            "text": "3. Relationships",
            "column_header": true,
            "row_header": false,
            "row_section": false,
            "fillable": false
          },
          {
            "bbox": {
              "l": 386.26484925,
