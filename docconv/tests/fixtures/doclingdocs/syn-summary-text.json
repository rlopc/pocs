            "col_span": 1,
            "start_row_offset_idx": 2,
            "end_row_offset_idx": 3,
            "start_col_offset_idx": 2,
            "end_col_offset_idx": 3,
            "text": "They fell out last year. \u00b7",
            "column_header": false,
            "row_header": false,
            "row_section": false,
            "fillable": false
