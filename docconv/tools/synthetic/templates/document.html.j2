<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.name }}</title>
<style>
  @page {
    size: A4;
    margin: 22mm 20mm 22mm 20mm;
    {% if doc.layout == "table" %}size: A4 landscape; margin: 10mm;{% endif %}
    {% if doc.running_header %}
    @top-center { content: "{{ doc.running_header }}"; font: 8pt sans-serif; color: #666; }
    {% endif %}
    {% if doc.page_numbers %}
    @bottom-right { content: counter(page); font: 8pt sans-serif; color: #666; }
    {% endif %}
  }
  body { font: 11pt/1.45 Georgia, "Times New Roman", serif; color: #111; }
  h1 { font-size: 20pt; margin: 0 0 6pt; }
  h2 { font-size: 15pt; margin: 14pt 0 6pt; }
  h3 { font-size: 12pt; margin: 8pt 0 4pt; }
  p { margin: 0 0 7pt; }
  {% if doc.layout == "reading" %}
  p { text-align: justify; hyphens: auto; }
  {% endif %}
  .box { border: 1.5pt solid #333; border-radius: 6pt; padding: 6pt 10pt; margin: 8pt 0; font-weight: bold; }
  .columns { display: flex; gap: 10pt; border: 1pt solid #444; border-radius: 6pt; padding: 6pt; }
  .columns > div { flex: 1; font-size: 9.5pt; }
  .columns ul { padding-left: 12pt; margin: 0; }
  ol.exercises { padding-left: 22pt; }
  ol.exercises li { margin-bottom: 9pt; }
  ol.exercises p { margin: 1pt 0; }
  table { border-collapse: collapse; width: 100%; font: 9pt/1.3 Helvetica, Arial, sans-serif; }
  th, td { border: 0.8pt solid #557; padding: 3pt 4pt; vertical-align: top; }
  th { background: #e8ecf8; }
  td.pic { white-space: nowrap; }
  td.pic img { width: 17mm; vertical-align: middle; }
  tr { break-inside: avoid; }
  .pagebreak { break-after: page; }
</style>
</head>
<body>
{% macro render(blocks) %}
{% for b in blocks %}
  {% set k = b | kind %}
  {% if k == "Heading" %}
    <h{{ b.level }}>{{ b.text }}</h{{ b.level }}>
  {% elif k == "Paragraph" %}
    <p>{{ b.runs | runs }}</p>
  {% elif k == "Box" %}
    <div class="box">{{ b.runs | runs }}</div>
  {% elif k == "Bullets" %}
    <ul>{% for i in b.items %}<li>{{ i | runs }}</li>{% endfor %}</ul>
  {% elif k == "Numbered" %}
    <ol start="{{ b.start }}">{% for i in b.items %}<li>{{ i | runs }}</li>{% endfor %}</ol>
  {% elif k == "Exercises" %}
    <ol class="exercises" start="{{ b.items[0].number }}">
    {% for ex in b.items %}
      <li><p>{{ ex.prompt | runs }}</p>
        <p>{% if ex.keyword_bold %}<strong>{{ ex.keyword }}</strong>{% else %}{{ ex.keyword }}{% endif %}</p>
        <p>{{ ex.answer | runs }}</p></li>
    {% endfor %}
    </ol>
  {% elif k == "Columns" %}
    <div class="columns">
    {% for c in b.columns %}<div><h3>{{ c.title }}</h3>{{ render(c.blocks) }}</div>{% endfor %}
    </div>
  {% elif k == "Table" %}
    <table>
      <tr>{% for h in b.header %}<th>{{ h }}</th>{% endfor %}</tr>
      {% for row in b.rows %}<tr>
        {% for cell in row %}
          {% if cell.image %}<td class="pic">{{ cell.number }} <img src="{{ image_uris[cell.image] }}" alt=""></td>
          {% else %}<td>{{ cell.runs | runs }}</td>{% endif %}
        {% endfor %}
      </tr>{% endfor %}
    </table>
  {% elif k == "PageBreak" %}
    <div class="pagebreak"></div>
  {% endif %}
{% endfor %}
{% endmacro %}
{{ render(doc.blocks) }}
</body>
</html>
